# moonraker.conf에 병합할 예시입니다.
# 라즈베리파이의 실제 IP 대역으로 192.168.0.0/24 부분만 바꾸세요.
# 이 프로젝트 UI를 라즈베리파이가 아닌 PC에서 실행한다면 해당 PC IP 또는 사설망 대역이 필요합니다.

[authorization]
trusted_clients:
  127.0.0.0/8
  192.168.0.0/24
cors_domains:
  http://127.0.0.1:8765

# `http://127.0.0.1:8765`는 개발 PC에서 이 저장소의 `node serve.js`로 연 화면입니다.
# 개발 PC에서 다른 주소/포트를 쓴다면 그 Origin을 정확히 추가하세요.
# enable_api_key 기본값은 True입니다. 이 UI는 API 키 로그인 흐름을 제공하지 않습니다.
# 외부에 공개하지 말고, 같은 사설망에서만 먼저 연결을 검증하세요.
