# Pi local browser only: leave PI2_BRIDGE_TOKEN empty and keep 127.0.0.1 binding.
PI2_MOTOR_CONTROL_DIR=/home/pi/pi2-motor-control
PI2_WEB_UI_ROOT=/home/pi/3d-printer-head-movement
MOONRAKER_HOST=127.0.0.1
MOONRAKER_PORT=7125
PI2_BRIDGE_HOST=127.0.0.1
PI2_BRIDGE_PORT=8766
PI2_BRIDGE_ORIGINS=http://127.0.0.1:8766

# For later external-PC use: set a long random token, bind to the Pi LAN IP or
# 0.0.0.0, and list only the exact web UI origin.
# PI2_BRIDGE_TOKEN=
